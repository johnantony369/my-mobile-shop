rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the authenticated user is the designated superadmin
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'johnantony271@gmail.com' ||
        (request.auth.token.keys().hasAny(['email']) && request.auth.token.email.lower() == 'johnantony271@gmail.com')
      );
    }

    // Each authenticated user can read and write all documents in their own user directory
    // (includes entries, jobs, stock, and settings).
    // Superadmin (johnantony271@gmail.com) has full read and write access across all user data.
    match /users/{userId}/{document=**} {
      allow read, write: if (request.auth != null && request.auth.uid == userId) || isSuperAdmin();
    }

    // Each authenticated user can read and write their own account profile summary.
    // Superadmin (johnantony271@gmail.com) can list and read all accounts, and update any account.
    match /accounts/{userId} {
      allow read, write: if (request.auth != null && request.auth.uid == userId) || isSuperAdmin();
    }

    // Public repairs tracking: Customers can read progress without login using their trackingId
    match /public_repairs/{trackingId} {
      allow read: if true;
      allow write: if request.auth != null || isSuperAdmin();
    }

    // Partners collection
    match /partners/{partnerId} {
      allow read: if request.auth != null && (request.auth.uid == partnerId || isSuperAdmin());
      allow create: if request.auth != null && request.auth.uid == partnerId;
      allow update: if request.auth != null && (
        (request.auth.uid == partnerId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'stats'])) ||
        isSuperAdmin()
      );
      allow delete: if request.auth != null && isSuperAdmin();
    }

    // Referral Leads collection
    match /referral_leads/{leadId} {
      allow read: if request.auth != null && (resource.data.partnerUid == request.auth.uid || isSuperAdmin());
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isSuperAdmin();
    }

    // Payouts collection
    match /payouts/{payoutId} {
      allow read: if request.auth != null && (resource.data.partnerUid == request.auth.uid || isSuperAdmin());
      allow create, update, delete: if request.auth != null && isSuperAdmin();
    }
  }
}
